    "@remotion/three": "^4.0.529",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
