{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loom-backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--app-dir", "services/delivery/api", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "school-policy-agent",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "school_policy_agent:app", "--app-dir", "services/agent-mesh/plugins", "--port", "8100"],
      "port": 8100
    },
    {
      "name": "loom-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "services/delivery/web"],
      "port": 3000
    }
  ]
}
