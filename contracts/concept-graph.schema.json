    "ObjectPart": {
      "additionalProperties": false,
      "description": "A named part of a diagram or drawing (petals, roots, one arrow, a table row), segmented at `t`. Its mask and\nbox are picture-relative at that moment; the player maps them onto the element's current box.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "mask": {
          "anyOf": [
            {
              "pattern": "^rle:\\d+x\\d+:\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask"
        },
        "part_id": {
          "pattern": "^p_\\d{2}$",
          "title": "Part Id",
          "type": "string"
        },
        "t": {
          "minimum": 0.0,
          "title": "T",
          "type": "number"
        }
      },
      "required": [
        "part_id",
        "label",
        "t",
        "bbox"
      ],
      "title": "ObjectPart",
      "type": "object"
    },
    "PerceptionMeta": {
      "additionalProperties": false,
