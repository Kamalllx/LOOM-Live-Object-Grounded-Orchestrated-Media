            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "element_kind": {
          "anyOf": [
            {
              "enum": [
                "text",
                "equation",
                "diagram",
                "table",
                "code",
                "chart",
                "illustration"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Kind"
