          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "object_id": {
          "pattern": "^o_\\d{3,}$",
          "title": "Object Id",
          "type": "string"
        },
        "parts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectPart"
          },
          "maxItems": 16,
          "title": "Parts",
          "type": "array"
        },
        "phrase_source": {
          "enum": [
            "hazard_class",
            "vlm",
            "transcript",
            "board"
          ],
