    "ConceptEvidence": {
      "additionalProperties": false,
      "properties": {
        "object_ids": {
          "default": [],
          "items": {
            "pattern": "^o_\\d{3,}$",
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        },
        "segment_ids": {
          "default": [],
          "items": {
            "pattern": "^s_\\d{3,}$",
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "text_ids": {
          "default": [],
          "items": {
            "pattern": "^x_\\d{3,}$",
            "type": "string"
          },
          "title": "Text Ids",
          "type": "array"
        }
      },
      "title": "ConceptEvidence",
      "type": "object"
    },
    "ConceptNode": {
      "additionalProperties": false,
      "properties": {
        "canonical_key": {
          "anyOf": [
            {
              "pattern": "^concept:[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Key"
        },
        "difficulty": {
          "enum": [
            "beginner",
            "intermediate",
            "expert"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ConceptEvidence"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "node_id": {
          "pattern": "^c_\\d{2,}$",
          "title": "Node Id",
          "type": "string"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "pattern": "^c_\\d{2,}$",
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "label",
        "summary",
        "evidence",
        "difficulty"
      ],
      "title": "ConceptNode",
      "type": "object"
    },
    "FrameInfo": {
      "additionalProperties": false,
      "properties": {
        "content_rect": {
          "default": [
            0.0,
            0.0,
            1.0,
            1.0
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Content Rect",
          "type": "array"
