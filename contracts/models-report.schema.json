{
  "$defs": {
    "ModelStatus": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "metrics": {
          "$ref": "#/$defs/RoleMetrics",
          "default": {
            "cache_hits": 0,
            "calls": 0,
            "failures": 0,
            "last_error": null,
            "last_latency_ms": null,
            "last_ok_at": null,
            "p50_ms": null,
            "p95_ms": null,
            "repairs": 0
          }
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "resident": {
          "default": false,
          "title": "Resident",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "size_vram_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Vram Bytes"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "role",
        "tag",
        "present"
      ],
      "title": "ModelStatus",
      "type": "object"
    },
    "RoleMetrics": {
      "additionalProperties": false,
      "properties": {
        "cache_hits": {
          "default": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "calls": {
          "default": 0,
          "title": "Calls",
          "type": "integer"
        },
        "failures": {
          "default": 0,
          "title": "Failures",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "last_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Latency Ms"
        },
        "last_ok_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Ok At"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Ms"
        },
        "repairs": {
          "default": 0,
          "title": "Repairs",
          "type": "integer"
        }
      },
      "title": "RoleMetrics",
      "type": "object"
    }
  },
  "$id": "https://loom.local/contracts/models-report.schema.json",
  "additionalProperties": false,
  "properties": {
    "gpu_holder": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu Holder"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelStatus"
      },
      "title": "Models",
      "type": "array"
    },
    "resident": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Resident",
      "type": "array"
    }
  },
  "required": [
    "models"
  ],
  "title": "ModelsReport",
  "type": "object",
  "x-loom-schema-version": "2.0"
}
