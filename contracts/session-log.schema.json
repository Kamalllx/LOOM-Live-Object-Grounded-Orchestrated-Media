{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "session-log",
  "description": "Contract D. Producer: delivery. Consumer: delivery/memory (folds into learner-profile), perception feedback.",
  "type": "object",
  "required": ["schema_version", "session_id", "learner_id", "events"],
  "properties": {
    "schema_version": { "type": "string" },
    "session_id": { "type": "string" },
    "learner_id": { "type": "string" },
    "video_id": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "timestamp"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["play", "pause", "seek", "object_tapped", "explainer_shown", "redaction_shown", "quiz_answered", "session_end"]
          },
          "timestamp": { "type": "number", "minimum": 0 },
          "payload": { "type": "object" }
        }
      }
    },
    "mastery_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept_id", "new_level"],
        "properties": {
          "concept_id": { "type": "string" },
          "new_level": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
