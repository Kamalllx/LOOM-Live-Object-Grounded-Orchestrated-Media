{
  "$id": "https://loom.local/contracts/job.schema.json",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dedupe_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedupe Key"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "id": {
      "pattern": "^job_[a-z0-9]+$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "ingest",
        "render",
        "prerender"
      ],
      "title": "Kind",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "default": {},
      "title": "Payload",
      "type": "object"
    },
    "progress": {
      "default": 0.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Progress",
      "type": "number"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "Job",
  "type": "object",
  "x-loom-schema-version": "2.0"
}
