{
  "name": "@loom/delivery",
  "version": "0.1.0",
  "private": true,
  "description": "LOOM Person 4 \u2014 Delivery, Memory & Infra. Next.js player for verified-cut.json.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
