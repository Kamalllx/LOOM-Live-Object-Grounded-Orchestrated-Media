# Copy to .env.local and edit. Every value below has a working default, so an
# empty .env.local is a valid configuration.
# cp .env.example .env.local

# ---------------------------------------------------------------------------
# Local API protection
# ---------------------------------------------------------------------------
# Use the same value for server and browser requests during local development.
LOOM_API_SECRET=loom-local-dev-secret
NEXT_PUBLIC_LOOM_API_SECRET=loom-local-dev-secret

# ---------------------------------------------------------------------------
# Contract C — where verified-cut.json comes from
# ---------------------------------------------------------------------------
# Unset  -> reads fixtures/verified-cut.sample.json from disk (default, works offline)
# Set    -> fetches from Person 3's verification service
# VERIFIED_CUT_URL=http://localhost:8003/verified-cut/sess_88a1

# ---------------------------------------------------------------------------
# Learner memory
# ---------------------------------------------------------------------------
# file  -> JSON files under data/memory/ (default, no Docker needed)
# mongo -> the container from infra/docker-compose.yml (npm i mongodb first)
MEMORY_DRIVER=file

# Only read when MEMORY_DRIVER=mongo. Port 27018 matches infra/docker-compose.yml.
MONGODB_URI=mongodb://loom:loom_dev_password@localhost:27018/loom?authSource=admin
MONGODB_DB=loom

# ---------------------------------------------------------------------------
# Cache (optional — everything works with it switched off)
# ---------------------------------------------------------------------------
# Leave unset to disable caching entirely. Set it to use the Redis container
# (npm i redis first). Port 6380 matches infra/docker-compose.yml.
# REDIS_URL=redis://localhost:6380
LEARNER_PROFILE_TTL_SECONDS=300
